{
    "files.associations": {},
    "clangd.path": "/usr/lib/llvm-21/bin/clangd",
    "clangd.arguments": [
        "--compile-commands-dir=vamana/build",
        "--header-insertion=never",
        "--header-insertion-decorators=0",
        "--cross-file-rename",
        // "--clang-tidy",
        // "--clang-tidy-checks=*",
    ],
    "C_Cpp.intelliSenseEngine": "disabled",
    "editor.formatOnSave": true,
    "search.include": [
        "vamana" // adjust this to your folder
    ],
    // Folders you want to exclude from search
    "search.exclude": {
        "vamana_old": true,
        "bang_exact": true,
        "vamana/docs": true,
    }
}